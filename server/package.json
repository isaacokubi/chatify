{
  "name": "chatify-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "seed": "node src/seed.js",
    "lint": "node --check src/index.js && node --check src/seed.js && node --check src/providers.js && node --check src/config.js && node --check src/lifecycle.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "uuid": "$uuid"
  }
}
