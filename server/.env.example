PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Use * only for local development. Production accepts comma-separated HTTPS web origins.
CLIENT_ORIGIN=*
SMTP_URL=smtps://<username>:<password>@<smtp-host>:465
SMTP_FROM=Chatify <no-reply@example.com>
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
FCM_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Payments: local demo uses mock mode and requires no Daraja credentials.
MPESA_ENV=mock
# For real sandbox calls, set MPESA_ENV=sandbox and obtain each value in the Daraja portal.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL to POST /api/payments/daraja/callback (use a tunnel for local development).
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
