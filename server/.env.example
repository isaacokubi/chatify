PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated allowed web origins. Replace with your real HTTPS frontend domain(s) in production.
# Keep * only in local development; production rejects wildcard origins.
CLIENT_ORIGIN=https://chatify-mobile.vercel.app
SMTP_URL=smtps://<username>:<password>@<smtp-host>:465
SMTP_FROM=Chatify <no-reply@example.com>
# School-specific M-Pesa STK Push and receipt email.
# Set these in the private API deployment environment, never commit real values.
# PUBLIC_API_URL must be the public HTTPS base URL for this API (for example, https://chatify-api.example.com).
PUBLIC_API_URL=https://your-chatify-api-domain.example
# Generate a unique random secret of at least 32 characters; losing it makes stored school Daraja credentials undecryptable.
SCHOOL_PAYMENT_ENCRYPTION_KEY=replace-with-a-unique-random-secret-at-least-32-characters
# Receipt delivery uses the SMTP_URL and SMTP_FROM values above.
# Public HTTPS web URL shown as the call-to-action after email confirmation.
PUBLIC_WEB_URL=https://your-chatify-web-domain.example
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
FCM_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Payments: mock mode is a simulation only; it never contacts Safaricom or moves money.
# Render/demo deployment: explicitly set MPESA_ENV=mock to start without Daraja credentials.
# Live payments require MPESA_ENV=production plus approved production Daraja credentials.
MPESA_ENV=mock
# Sandbox is blocked when NODE_ENV=production unless this exact opt-in is set to true.
# This never changes the selected Daraja host: sandbox mode always uses the sandbox host.
MPESA_ALLOW_SANDBOX_IN_PRODUCTION=false
# In development/test, MPESA_CONSUMER_KEY/SECRET/SHORTCODE/PASSKEY are used with MPESA_ENV.
# A production runtime must use a mode-scoped credential set instead:
# MPESA_PRODUCTION_CONSUMER_KEY, MPESA_PRODUCTION_CONSUMER_SECRET,
# MPESA_PRODUCTION_SHORTCODE, MPESA_PRODUCTION_PASSKEY
# or (only with the explicit sandbox opt-in) MPESA_SANDBOX_CONSUMER_KEY,
# MPESA_SANDBOX_CONSUMER_SECRET, MPESA_SANDBOX_SHORTCODE, MPESA_SANDBOX_PASSKEY.
# For local development only, set MPESA_ENV=sandbox and obtain sandbox values in the Daraja portal.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Generate callback tokens with: openssl rand -hex 32. Keep them secret and redact callback paths from access logs.
MPESA_CALLBACK_TOKEN=replace-with-at-least-32-random-characters
# Public HTTPS URL must end with /api/payments/daraja/callback/<same-token>.
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# School STK callbacks use a separate secret token in their URL path.
SCHOOL_DARAJA_CALLBACK_TOKEN=replace-with-at-least-32-random-characters
# POS Paybill C2B confirmations require a long random URL token; register this endpoint
# for merchant shortcodes with Safaricom and use the exact public HTTPS URL.
POS_C2B_CALLBACK_TOKEN=replace-with-at-least-32-random-characters
# Optional comma-separated trusted Safaricom callback source IPs; keep current with Daraja docs.
POS_C2B_ALLOWED_IPS=
# Merchant-specific POS STK Push. Keep these server-side secrets private.
# Generate once: openssl rand -hex 32. Back up securely; rotation needs credential re-encryption.
POS_DARAJA_ENCRYPTION_KEY=replace-with-64-hex-characters
# Generate a distinct random callback token: openssl rand -hex 32
POS_STK_CALLBACK_TOKEN=replace-with-at-least-32-random-characters
# Public HTTPS origin for this API, e.g. https://chatify-api.example
POS_STK_PUBLIC_BASE_URL=https://your-api.example
# Demo seeding is opt-in and only allowed with NODE_ENV=development.
CHATIFY_SEED_DEMO=NO
CHATIFY_SEED_DRY_RUN=NO
CHATIFY_SEED_VERIFY_LOGIN=NO
SEED_DEMO_PASSWORD=

# Business tax profiles are operator-configured; verify rates with the relevant authority.
# Set these only after verifying your approved KRA eTIMS gateway contract.
ETIMS_SUBMISSION_URL=
ETIMS_API_TOKEN=
ETIMS_TAXPAYER_PIN=
# Messaging provider credentials are optional; sends are disabled without them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Optional OpenAI-compatible language/speech services. Audio/text is sent to this provider
# only after the authenticated user explicitly confirms consent in the request.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TEXT_MODEL=gpt-4o-mini
AI_AUDIO_MODEL=whisper-1
# Optional external scheduler ping; internal workflow tick requires this bearer secret.
BUSINESS_WORKFLOW_CRON_SECRET=

# Optional international hosted checkout; invoice settlement requires the signed webhook below.
STRIPE_ENV=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://chatify-mobile.vercel.app/?payment=success
STRIPE_CANCEL_URL=https://chatify-mobile.vercel.app/?payment=cancelled

# Optional PayPal Orders v2 checkout. Configure the webhook ID from your PayPal developer dashboard.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SUCCESS_URL=https://chatify-mobile.vercel.app/?payment=success
PAYPAL_CANCEL_URL=https://chatify-mobile.vercel.app/?payment=cancelled

# Optional administrator seed credentials. Keep these only in your private deployment environment,
# never commit real values. Run npm run seed:admin from server/ to create/promote this account.
ADMIN_NAME=Chatify Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-secret
